{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin",
  "version": "0.1.0",
  "identifier": "app.margin.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Margin",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Margin",
    "copyright": "Copyright (c) Margin contributors",
    "category": "Productivity",
    "shortDescription": "A local, author-first writing studio",
    "longDescription": "Margin is a desktop app for writing books, with a quiet assistant that runs entirely on your own computer. No network, no telemetry.",
    "resources": {
      "fonts/eb-garamond/OFL.txt": "licenses/fonts/eb-garamond-OFL.txt",
      "fonts/crimson-text/OFL.txt": "licenses/fonts/crimson-text-OFL.txt",
      "fonts/source-serif-4/OFL.md": "licenses/fonts/source-serif-4-OFL.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English"], "displayLanguageSelector": false },
      "wix": { "language": "en-US" }
    }
  }
}
